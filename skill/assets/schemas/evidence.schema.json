{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "simplecae-evidence-1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "material",
              "procurement",
              "interfaces",
              "assembly",
              "structure",
              "contact",
              "actuation",
              "force_calibration",
              "control",
              "fault_response",
              "lifetime",
              "physical_acceptance"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "unassessed",
              "calculated",
              "physical_pending",
              "physical_recorded"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "kind": {
                  "enum": [
                    "simulation",
                    "analytic_calculation",
                    "supplier_document",
                    "software_build",
                    "software_test",
                    "physical_test",
                    "physical_inspection"
                  ]
                },
                "applies_to": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "source_sha256": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  }
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "pass",
                    "fail",
                    "inconclusive"
                  ]
                },
                "date": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "type": "string",
                  "minLength": 1
                },
                "test_method": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file",
                "kind",
                "applies_to",
                "source_sha256",
                "scope"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "domain",
          "title",
          "state",
          "statement",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notes": {}
  },
  "required": [
    "schema_version",
    "title",
    "bindings",
    "items"
  ],
  "additionalProperties": false
}
